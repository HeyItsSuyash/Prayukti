---
import '@fontsource/inter/index.css';
import '@/styles/globals.css';

import { ScrollToTop } from "@/components/ui/ScrollToTop";
import { AssistantBot } from "@/components/ui/AssistantBot";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Prayukti x MMMUT",
  description = "Virtual Laboratory Platform for Madan Mohan Malaviya University of Technology, Gorakhpur" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <slot />
    <!-- client:idle for non-critical interactive elements -->
    <ScrollToTop client:idle />
    <AssistantBot client:idle />
  </body>
</html>

<style is:global>
  :root {
    --font-inter: 'InterVariable', sans-serif;
  }
</style>
