# Database configuration (Required)
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://<username>:<password>@localhost:5432/<database_name>


# Server port configuration (Optional, defaults to 5000)
PORT=5000

# Authentication configuration (Optional, fallback provided in code)
JWT_SECRET=your_jwt_secret_key_here

# Email Provider Configuration (Brevo/Sendinblue - Optional)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME="Prayukti vLAB"
EMAIL_FROM_ADDRESS=noreply@prayukti.org

# Frontend URLs for CORS configuration (Optional, fallback provided in code)
STUDENT_FRONTEND_URL=http://localhost:3000
TEACHER_FRONTEND_URL=http://localhost:3001
