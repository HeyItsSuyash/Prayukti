  "query": "\n        SELECT ai.insight_type, ai.message, ai.confidence, u.full_name, u.roll_no\n        FROM ai_insights ai\n        JOIN users u ON ai.student_id = u.id\n        ORDER BY ai.created_at DESC\n        LIMIT 20\n        ",
