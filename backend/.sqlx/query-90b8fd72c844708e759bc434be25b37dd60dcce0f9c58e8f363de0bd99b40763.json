  "query": "\n            SELECT c.id, c.user_id, c.content, c.created_at, u.full_name\n            FROM announcement_comments c\n            JOIN users u ON c.user_id = u.id\n            WHERE c.announcement_id = $1\n            ORDER BY c.created_at ASC\n            ",
