  "query": "\n        SELECT h.watched_at, l.id, l.topic, l.mode, l.avatar\n        FROM video_watch_history h\n        JOIN video_lessons l ON h.lesson_id = l.id\n        WHERE h.student_id = $1\n        ORDER BY h.watched_at DESC\n        LIMIT 20\n        ",
