{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "frontend_teacher/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/teacher/(.*)",
      "dest": "/frontend_teacher/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
