# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
NODE_ENV=development

# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://prayukti:prayukti_pass@localhost:5432/prayukti_vlab

# ================================
# REDIS
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=prayukti:

# ================================
# JWT / AUTH
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ================================
# EMAIL
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Prayukti vLAB <noreply@prayukti.com>

# ================================
# RATE LIMITING
# ================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ================================
# LOGGING
# ================================
LOG_LEVEL=debug
